{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebUiConfiguration": {
    "DefaultTheme": "flink-default",
    "ThemeCacheDuration": 300
  },
  "MetricsConfiguration": {
    "EnableMetrics": true,
    "RequireBasicAuth": true,
    "BasicAuthUsername": "flink",
    "BasicAuthPassword": "flink",
    "MetricsEndpointPath": "/metrics"
  },
  "DbConfiguration": {
    "DbType": "Sqlite",
    "SqliteConnectionString": "Data Source=flink.db;"
  },
  "SpamProtectionConfiguration": {
    "Enabled": true,
    "BlockLists": [
      "https://easylist.to/easylist/easylist.txt",
      "https://secure.fanboy.co.nz/fanboy-annoyance.txt"
    ],
    "RefreshIntervalInHours": 48
  }
}
