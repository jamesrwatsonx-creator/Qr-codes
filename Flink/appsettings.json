{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "AllowedHosts": "*",
  "HTTP_PROXY": null,
  "HTTPS_PROXY": null,
  "SOCKS_PROXY": null,
  "NO_PROXY": null,
  "Tracing": {
    "EnableConsoleTracing": false
  },
  "WebUiConfiguration": {
    "DefaultTheme": "flink-default",
    "ThemeCacheDuration": 300
  },
  "MetricsConfiguration": {
    "EnableMetrics": true,
    "RequireBasicAuth": true,
    "BasicAuthUsername": "flink",
    "BasicAuthPassword": "flink",
    "MetricsEndpointPath": "/metrics"
  },
  "DbConfiguration": {
    "DbType": "Sqlite",
    "SqliteConnectionString": "Data Source=flink.db",
    "PostgresConnectionString": "Server=localhost;Port=5432;Database=flink;User Id=flink;Password=flink;"
  },
  "SpamProtectionConfiguration": {
    "Enabled": true,
    "BlockListSources": [
      "https://easylist.to/easylist/easylist.txt",
      "https://secure.fanboy.co.nz/fanboy-annoyance.txt",
      "https://malware-filter.gitlab.io/malware-filter/phishing-filter-agh.txt",
      "https://github.com/Phishing-Database/Phishing.Database/raw/refs/heads/master/phishing-domains-ACTIVE.adblock",
      "https://gitlab.com/rtraceio/web/flink/-/raw/main/flink-blocklist.txt",
      "https://raw.githubusercontent.com/uBlockOrigin/uAssetsCDN/refs/heads/main/filters/badware.txt"
    ],
    "CustomBlockedHosts": [],
    "RefreshIntervalInHours": 2
  },
  "EventNotificationConfiguration": {
    "Sinks": [
    ]
  }
}
